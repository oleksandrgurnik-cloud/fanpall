# Leave DATABASE_URL empty (or set USE_MOCK_DB=true) to run without Postgres.
# Demo data lives in memory — fine for Vercel preview / demos.
# USE_MOCK_DB="true"

# Optional: real Postgres (Neon/Supabase). When set, mock mode is off unless USE_MOCK_DB=true.
# DATABASE_URL="postgresql://user:pass@host:5432/funpall?sslmode=require"

# NextAuth — on Vercel set NEXTAUTH_URL to your deployment URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# Optional OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
