# Database — use a standard PostgreSQL connection string
# Example for local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/funpall?schema=public"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/funpall?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# Optional OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
