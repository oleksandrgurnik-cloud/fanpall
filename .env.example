# Database — PostgreSQL connection string
# Local:  postgresql://postgres:postgres@localhost:5432/funpall?schema=public
# Vercel: use Neon/Supabase/Prisma Postgres pooled URL (include ?sslmode=require)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/funpall?schema=public"

# NextAuth — on Vercel set NEXTAUTH_URL to your deployment URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production"

# Optional OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
